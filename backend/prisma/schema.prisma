generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum TransactionType {
  EXPENSE
  CREDIT_CARD
  TAX
  INVESTMENT
}

enum PaymentMethod {
  PIX
  CASH
  DEBIT_CARD
  BANK_TRANSFER
  OTHER
}

enum TaxType {
  MEI
  IRPF
  IPVA
  IRRF
  ITR
  ITCMD
  IPTU
  COFINS
  PIS
  ICMS
  ISS
  IOF
  OTHER
}

enum TaxFrequency {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}


enum InvestmentStatus {
  ACTIVE
  MATURED
  SOLD
  CANCELLED
}

enum InvestmentType {
  STOCKS
  FUNDS
  CRYPTO
  SAVINGS
  CDB
  LCI_LCA
  DEBENTURES
  TREASURY
  ETF
  OTHER
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  avatar        String?
  role          Role     @default(MEMBER)
  created_at    DateTime @default(now())

  financialData FinancialData[]
  creditCardPurchases CreditCardPurchase[]
  salaryProfiles SalaryProfile[]
  expenses Expense[]
  incomes Income[]
  investments Investment[]
  taxes Tax[]
  imports Import[]

  @@map("users")
}

model FinancialData {
  id          String @id @default(uuid())
  month       String
  year        Int
  user_id     String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Monthly income
  main_income     Decimal @default(0)
  checking_account Decimal @default(0)
  previous_balance Decimal @default(0)
  total_in_account Decimal @default(0)

  // Calculated totals
  expense_subtotal      Decimal @default(0)
  investment_subtotal   Decimal @default(0)
  credit_card_subtotal  Decimal @default(0)
  tax_subtotal          Decimal @default(0)
  total_income          Decimal @default(0)
  total_expenses        Decimal @default(0)
  final_balance         Decimal @default(0)
  expected_total_money  Decimal @default(0)

  // Controle de fechamento do mês
  is_confirmed Boolean @default(false)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@unique([user_id, month, year])
  @@map("financial_data")
}

model Transaction {
  id               String          @id @default(uuid())
  name             String
  actual_cost      Decimal
  difference       Decimal
  type             TransactionType
  financial_data_id String
  created_at       DateTime        @default(now())

  financialData FinancialData @relation(fields: [financial_data_id], references: [id], onDelete: Cascade)

  @@map("transactions")
}


model CreditCardPurchase {
  id              String   @id @default(uuid())
  name            String
  description     String?
  total_amount    Decimal
  installments    Int?
  installment_amount Decimal
  start_month     String
  start_year      Int
  end_month       String?
  end_year        Int?
  category        String?
  is_recurring    Boolean  @default(false)
  user_id         String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  installments_data CreditCardInstallment[]

  @@map("credit_card_purchases")
}

model CreditCardInstallment {
  id                String @id @default(uuid())
  purchase_id       String
  purchase_name     String
  installment_amount Decimal
  current_installment Int
  total_installments Int
  month            String
  year             Int
  created_at       DateTime @default(now())

  creditCardPurchase CreditCardPurchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)

  @@map("credit_card_installments")
}

model SalaryProfile {
  id          String    @id @default(uuid())
  amount      Decimal
  description String?
  start_date  DateTime
  end_date    DateTime?
  is_active   Boolean   @default(true)
  user_id     String
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("salary_profiles")
}

model Expense {
  id             String        @id @default(uuid())
  name           String
  description    String?
  amount         Decimal
  payment_method PaymentMethod
  category       String?
  month          String
  year           Int
  date           DateTime      @default(now())
  user_id        String
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("expenses")
}

model Income {
  id             String        @id @default(uuid())
  name           String
  description    String?
  amount         Decimal
  source         String?
  category       String?
  month          String
  year           Int
  date           DateTime      @default(now())
  user_id        String
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("incomes")
}

model Investment {
  id                  String             @id @default(uuid())
  name                String
  description         String?
  amount              Decimal            // Valor aplicado
  gross_yield         Decimal?           // Valor bruto atual
  net_value           Decimal?           // Valor líquido atual
  investment_type     InvestmentType
  category            String?
  date                DateTime           @default(now())
  purchase_date       DateTime?          // Data de compra (pode ser diferente da date)
  maturity_date       DateTime?          // Data de vencimento
  interest_rate       Decimal?           // Taxa de juros
  quantity            Decimal?           // Quantidade de cotas/ações
  broker              String?            // Corretora
  ticker              String?            // Código do ativo
  dividend_yield      Decimal?           // Dividend yield
  status              InvestmentStatus   @default(ACTIVE)
  notes               String?
  user_id             String
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  snapshots InvestmentSnapshot[]

  @@map("investments")
}

model InvestmentSnapshot {
  id              String   @id @default(uuid())
  investment_id   String
  gross_yield     Decimal
  net_value       Decimal?
  recorded_at     DateTime @default(now())

  investment Investment @relation(fields: [investment_id], references: [id], onDelete: Cascade)

  @@index([investment_id, recorded_at])
  @@map("investment_snapshots")
}

enum ImportTransactionType {
  EXPENSE
  INCOME
  INVESTMENT
  TAX
  TRANSFER
  IGNORE
}

model Import {
  id             String        @id @default(uuid())
  file_name      String
  month          String
  year           Int
  status         String        @default("pending") // pending, reviewed, confirmed
  total_transactions Int       @default(0)
  user_id        String
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions ImportTransaction[]

  @@map("imports")
}

model ImportTransaction {
  id                String                @id @default(uuid())
  import_id         String
  date              DateTime
  description       String
  original_description String
  amount            Decimal
  type              ImportTransactionType  @default(EXPENSE)
  category          String?
  is_credit         Boolean               @default(false) // true = entrada, false = saída
  is_duplicate      Boolean               @default(false)
  duplicate_of      String?               // descrição do registro existente que pode ser duplicata
  group_key         String?               // chave de agrupamento (transações do mesmo destinatário)
  is_confirmed      Boolean               @default(false)
  created_at        DateTime              @default(now())

  import Import @relation(fields: [import_id], references: [id], onDelete: Cascade)

  @@map("import_transactions")
}

model Tax {
  id              String        @id @default(uuid())
  tax_type        TaxType
  amount          Decimal
  payment_method  PaymentMethod
  frequency       TaxFrequency
  day_of_month    Int
  month           String
  year            Int
  due_date        DateTime
  user_id         String
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("taxes")
}


